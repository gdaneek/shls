#!/usr/sbin/nft -f
# Mini Checkers firewall: filters traffic between containers inside the
# internal segments (Docker bridges mc-data and mc-msg). Everything that is
# not explicitly allowed below is logged and dropped.
#
# The bridge family sees frames switched inside a bridge without
# br_netfilter, and it does not interfere with Docker's own iptables rules.
# Traffic between segments has no route at all (internal networks), so it
# never reaches this table.
#
# Apply: infrastructure/firewall/firewall.sh apply
# The file replaces the whole table atomically, so it can be re-applied.

define DATA_BRIDGE = "mc-data"
define MESSAGING_BRIDGE = "mc-msg"

# IP plan, must match docker-compose.yml.
define GAME_API_DATA = 10.10.2.2
define POSTGRES = 10.10.2.3
define REDIS = 10.10.2.4
define GAME_API_MESSAGING = 10.10.3.2
define RABBITMQ = 10.10.3.3
define EVENT_WORKER = 10.10.3.4

table bridge mini_checkers
delete table bridge mini_checkers

table bridge mini_checkers {
  chain forward {
    type filter hook forward priority filter; policy accept;

    # Other bridges on the host are not ours: leave them alone.
    meta ibrname != { $DATA_BRIDGE, $MESSAGING_BRIDGE } accept

    # Address resolution and replies to allowed connections.
    ether type arp accept
    ct state established,related accept

    # Explicit ALLOW rules (new TCP connections only).
    meta ibrname $DATA_BRIDGE ip saddr $GAME_API_DATA ip daddr $POSTGRES tcp dport 5432 ct state new counter accept comment "ALLOW game-api -> postgres"
    meta ibrname $DATA_BRIDGE ip saddr $GAME_API_DATA ip daddr $REDIS tcp dport 6379 ct state new counter accept comment "ALLOW game-api -> redis"
    meta ibrname $MESSAGING_BRIDGE ip saddr $GAME_API_MESSAGING ip daddr $RABBITMQ tcp dport 5672 ct state new counter accept comment "ALLOW game-api -> rabbitmq"
    meta ibrname $MESSAGING_BRIDGE ip saddr $EVENT_WORKER ip daddr $RABBITMQ tcp dport 5672 ct state new counter accept comment "ALLOW event-worker -> rabbitmq"

    # Explicit DENY: everything else inside the segments.
    limit rate 10/second burst 20 packets log prefix "mc-fw-drop: " level info
    counter drop comment "DENY everything else in mc-data / mc-msg"
  }
}
