# Copy to .env and replace the placeholders with your own secrets.
# Public frontend port (the API is available through /api/ on the same port).
API_PORT=8000
POSTGRES_PASSWORD=change-me-postgres
# Updated by the explicit promotion script; start with postgres on fresh data.
POSTGRES_PRIMARY_HOST=postgres
# Separate replication credential: replace with `openssl rand -hex 32` output.
POSTGRES_REPLICATION_PASSWORD=generate-64-hex-characters
RABBITMQ_PASSWORD=change-me-rabbitmq
