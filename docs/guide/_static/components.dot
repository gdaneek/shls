digraph Components {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", fontsize=13];
  node [shape=box, style="rounded,filled", color="#56728a", fillcolor="#eef4f8", fontname="DejaVu Sans", fontsize=11, margin="0.18,0.12"];
  edge [color="#587083", fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];

  subgraph cluster_api {
    label="game-api · один C++ процесс";
    color="#a7c1d4";
    style="rounded";
    main [label="main.cc\nконфигурация, клиенты, запуск"];
    handlers [label="game_api.cc\nHTTP-обработчики"];
    rules [label="game_rules.cc\nправила и проверка ходов"];
    publisher [label="event_publisher.cc\nфоновый поток outbox"];
  }

  schema [label="schema.sql\nсхема и совместимые изменения", fillcolor="#ffffff"];
  db [label="PostgreSQL\nигры и outbox_events", fillcolor="#f1f7e8"];
  redis [label="Redis\nкеш game:{id}", fillcolor="#f1f7e8"];
  mq [label="RabbitMQ\nquorum queue", fillcolor="#fff4e5"];

  main -> schema [label="читает при старте"];
  main -> handlers [label="регистрирует"];
  main -> publisher [label="запускает"];
  handlers -> rules [label="проверка и применение"];
  handlers -> db [label="чтение / транзакция"];
  handlers -> redis [label="чтение / DEL"];
  publisher -> db [dir=both, label="SELECT / DELETE после confirm"];
  publisher -> redis [label="повторная инвалидация"];
  publisher -> mq [label="publish + confirm"];
}
