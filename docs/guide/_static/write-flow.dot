digraph WriteFlow {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", color="#56728a", fillcolor="#eef4f8", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.1"];
  edge [color="#587083", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  request [label="HTTP запрос через frontend", fillcolor="#ffffff"];
  validate [label="Game API\nпроверка токена, состояния и хода"];
  tx [label="PostgreSQL: одна транзакция\nигра / ход + запись outbox", fillcolor="#f1f7e8"];
  cache [label="API: DEL game:{id}\nRedis", fillcolor="#f1f7e8"];
  response [label="HTTP ответ клиенту", fillcolor="#ffffff"];
  publisher [label="Publisher: чтение outbox\nповторная инвалидация кеша"];
  broker [label="RabbitMQ: publish", fillcolor="#fff4e5"];
  confirmed [label="Publisher: confirm → DELETE outbox", fillcolor="#f1f7e8"];
  worker [label="Worker: лог события + ACK", fillcolor="#fff4e5"];
  request -> validate -> tx;
  tx -> cache -> response;
  tx -> publisher [label="асинхронно"];
  publisher -> broker;
  broker -> confirmed [label="подтверждение приёма"];
  broker -> worker [label="доставка"];
}
